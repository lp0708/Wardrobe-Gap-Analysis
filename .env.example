# Copy this file to .env and fill in your key. .env is gitignored.
GEMINI_API_KEY=your-gemini-api-key-here

# Free-tier quota is ~20 requests/day PER MODEL; one agent run costs 4-7.
# Switch to another Flash model for a fresh quota bucket when you hit a 429.
GEMINI_MODEL=gemini-3.6-flash

# 1 = save runs to .agent_cache/ and replay them (zero API calls on repeat).
AGENT_CACHE=0
