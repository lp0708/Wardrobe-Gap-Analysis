# Copy this file to .env and fill in your key. .env is gitignored.
GEMINI_API_KEY=your-gemini-api-key-here

# Free-tier quota is ~20 requests/day PER MODEL; one agent run usually costs 3.
# Switch to another Flash model for a fresh quota bucket when you hit a 429.
GEMINI_MODEL=gemini-3.6-flash

# Completed runs are always saved to .agent_cache/ (the platform pages read them).
# 1 = also replay a customer's saved run instead of calling Gemini again.
AGENT_CACHE=0
